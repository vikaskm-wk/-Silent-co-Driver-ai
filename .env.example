# ============================================================
# SILENT CO-DRIVER AI - MINIMAL ENVIRONMENT CONFIGURATION
# ============================================================

# 1. Google Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Hugging Face Access Token (Server-side only secret)
HF_TOKEN=YOUR_HUGGINGFACE_TOKEN_HERE

# 3. Whisper ASR Model ID
HF_ASR_MODEL=openai/whisper-tiny.en

# 4. Speech Emotion Recognition Model ID
HF_AUDIO_EMOTION_MODEL=ehcalabres/wav2vec2-lg-xlsr-en-speech-emotion-recognition
